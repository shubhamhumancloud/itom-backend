# HTTP server
PORT=3005

# Postgres (point at your locally-installed Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=itom
DB_PASSWORD=itom
DB_NAME=itom

# Set to 'true' to log every SQL query (noisy, dev only)
DB_LOGGING=false

# --- Agent install flow ---------------------------------------------------
# Reachable URL of THIS API from a customer's network. Baked into the agent
# binary at install-request time, so the agent knows where to phone home.
# Falls back to request headers if unset (dev convenience only).
# MUST be set in any environment where the dashboard is on a different host
# from the API (e.g. behind a load balancer or reverse proxy).
ITOM_SERVER_URL=http://localhost:3005

# HMAC secret for signing per-tenant install tokens. Must be >=32 chars.
# If unset, the server uses an ephemeral key — tokens minted by one process
# die when the process restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ITOM_INSTALL_TOKEN_SECRET=change-me-generate-with-the-node-one-liner-above

# Optional: install token TTL in seconds. Default 3600 (1h). Range 60..86400.
# ITOM_INSTALL_TOKEN_TTL_SECONDS=3600

# Optional: where the agent template binaries live on disk. Defaults to
# {AGENTS_DIST_PATH or ./agents-dist}/templates. Set this if you keep
# templates outside the BE working directory.
# AGENT_TEMPLATES_PATH=/var/lib/itom/agent-templates
